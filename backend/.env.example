APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TASK_MAX_WORKERS=2
DATABASE_URL=mysql+pymysql://pdfai:password@localhost:3306/pdfai
STORAGE_ROOT=../storage

PDF_RENDER_DPI=300
PDF_RENDER_FORMAT=png
CROP_PADDING_RATIO=0.06

AI_BASE_URL=https://example.com/v1
AI_API_KEY=replace-with-real-key
AI_MODEL=replace-with-vision-model
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_ENABLE_FULL_PAGE_EXTRACTION=true
AI_ENABLE_REGION_EXTRACTION=false
AI_IMAGE_MAX_EDGE=1600
AI_IMAGE_JPEG_QUALITY=75

# 自动故障切换：当前配置遇到"服务不可用"类错误时，自动切换到下一套可用配置并重放本次调用。
AI_ENABLE_AUTO_FAILOVER=true
# 失败配置的冷却秒数，冷却期内不会被优先选用；到期后自动恢复候选资格（半开探测）。
AI_FAILOVER_COOLDOWN_SECONDS=300
# 单次调用允许的最大切换次数。0 表示不额外限制，最多尝试候选链中所有配置。
AI_FAILOVER_MAX_SWITCHES=0
# "模型不支持图片"是否也触发切换。默认关闭：这是能力问题而非可用性问题。
AI_FAILOVER_ON_VISION_UNSUPPORTED=false
